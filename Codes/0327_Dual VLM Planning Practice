def _move_to_device(inputs, device):
    moved = {}
    for k, v in inputs.items():
        if hasattr(v, "to"):
            moved[k] = v.to(device)
        else:
            moved[k] = v
    return moved


def clean_image_for_vlm(image_path: str):
    image = Image.open(image_path)
    image = ImageOps.exif_transpose(image).convert("RGB")
    return image


def extract_confidence(text: str, default: float = 0.5) -> float:
    """
    다양한 confidence 출력 형식을 robust하게 파싱
    예:
    - Confidence Score: 0.72
    - 6. Confidence Score (0.0~1.0)
      - 0.72
    - Updated Confidence Score (0.0~1.0): 0.72
    """
    patterns = [
        r"Updated Confidence Score.*?:\s*-?\s*([01](?:\.\d+)?)",
        r"Confidence Score.*?:\s*-?\s*([01](?:\.\d+)?)",
        r"Confidence.*?:\s*-?\s*([01](?:\.\d+)?)",
        r"Updated Confidence Score[^\n]*\n\s*[-*]?\s*([01](?:\.\d+)?)",
        r"Confidence Score[^\n]*\n\s*[-*]?\s*([01](?:\.\d+)?)",
        r"6\.\s*Updated Confidence Score[^\n]*\n\s*[-*]?\s*([01](?:\.\d+)?)",
        r"6\.\s*Confidence Score[^\n]*\n\s*[-*]?\s*([01](?:\.\d+)?)",
    ]

    for pattern in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            try:
                value = float(match.group(1))
                return max(0.0, min(1.0, value))
            except ValueError:
                pass

    # fallback: text 끝부분 근처의 0~1 float 탐색
    tail = text[-300:]
    candidates = re.findall(r"(?<!\d)([01](?:\.\d+)?)(?!\d)", tail)
    if candidates:
        try:
            value = float(candidates[-1])
            return max(0.0, min(1.0, value))
        except ValueError:
            pass

    return default


def extract_yes_no(text: str, keyword: str, default: int = 0) -> int:
    pattern = rf"{keyword}.*?:\s*(Yes|No)"
    match = re.search(pattern, text, re.IGNORECASE)
    if match:
        return 1 if match.group(1).lower() == "yes" else 0
    return default


def extract_score(text: str, label: str, default: float) -> float:
    pattern = rf"{label}\s*:\s*([01](?:\.\d+)?)"
    match = re.search(pattern, text, re.IGNORECASE)
    if match:
        try:
            value = float(match.group(1))
            return max(0.0, min(1.0, value))
        except ValueError:
            pass
    return default


def run_vlm(image_path: str, prompt: str, max_new_tokens: int = MAX_NEW_TOKENS_VLM) -> str:
    image = clean_image_for_vlm(image_path)

    messages = [
        {
            "role": "user",
            "content": [
                {"type": "image"},
                {"type": "text", "text": prompt},
            ],
        }
    ]

    text = processor.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
    )

    inputs = processor(
        text=[text],
        images=[image],
        return_tensors="pt",
    )

    inputs = _move_to_device(inputs, model.device)

    with torch.no_grad():
        generated_ids = model.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=processor.tokenizer.pad_token_id,
            eos_token_id=processor.tokenizer.eos_token_id,
        )

    new_tokens = generated_ids[:, inputs["input_ids"].shape[1]:]

    output_text = processor.batch_decode(
        new_tokens,
        skip_special_tokens=True,
        clean_up_tokenization_spaces=False,
    )[0]

    return output_text.strip()

def run_text_only(prompt: str, max_new_tokens: int = MAX_NEW_TOKENS_TEXT) -> str:
    messages = [
        {
            "role": "user",
            "content": [
                {"type": "text", "text": prompt},
            ],
        }
    ]

    text = processor.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
    )

    inputs = processor(
        text=[text],
        return_tensors="pt",
    )

    inputs = _move_to_device(inputs, model.device)

    with torch.no_grad():
        generated_ids = model.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=processor.tokenizer.pad_token_id,
            eos_token_id=processor.tokenizer.eos_token_id,
        )

    new_tokens = generated_ids[:, inputs["input_ids"].shape[1]:]

    output_text = processor.batch_decode(
        new_tokens,
        skip_special_tokens=True,
        clean_up_tokenization_spaces=False,
    )[0]

    return output_text.strip()


def compute_U(conf_a: float, conf_b: float, disagreement: float, consistency: float) -> float:
    """
    uncertainty:
    - confidence 높을수록 감소
    - disagreement 높을수록 증가
    - consistency 높을수록 감소
    """
    w_conf = 1 / 3
    w_dis = 1 / 3
    w_con = 1 / 3

    conf_avg = (conf_a + conf_b) / 2.0
    U = 1.0 - (w_conf * conf_avg + w_con * consistency - w_dis * disagreement)
    return max(0.0, min(1.0, U))


