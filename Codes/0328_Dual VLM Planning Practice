import re
import torch
from PIL import Image, ImageOps


image_a_path = "kitchen_clean.jpg"
image_b_path = "livingroom_clean.jpg"

AGENT_A_ROLE = "kitchen"
AGENT_B_ROLE = "living room"

TASK = """
Friends are scheduled to arrive in 30 minutes.
Please prepare the house — kitchen and living room — accordingly.
"""

COLLABORATION_ROUNDS = 2   # Phase 2 반복 횟수

MAX_NEW_TOKENS_VLM     = 400
MAX_NEW_TOKENS_AGENT   = 400
MAX_NEW_TOKENS_CENTRAL = 600



# 1. Utilities


def _move_to_device(inputs, device):
    return {k: v.to(device) if hasattr(v, "to") else v for k, v in inputs.items()}


def clean_image_for_vlm(image_path: str) -> Image.Image:
    image = Image.open(image_path)
    return ImageOps.exif_transpose(image).convert("RGB")


def extract_section(text: str, tag: str) -> str:
    pattern = rf"<{tag}>(.*?)</{tag}>"
    match = re.search(pattern, text, re.DOTALL)
    return match.group(1).strip() if match else ""


def print_phase(title: str):
    print("\n" + "=" * 60)
    print(title)
    print("=" * 60)


# 2. Runners

def run_vlm(image_path: str, prompt: str) -> str:
    """Vision + text → text  (Phase 1 observation)"""
    image = clean_image_for_vlm(image_path)
    messages = [{
        "role": "user",
        "content": [{"type": "image"}, {"type": "text", "text": prompt}],
    }]
    text = processor.apply_chat_template(
        messages, tokenize=False, add_generation_prompt=True
    )
    inputs = processor(text=[text], images=[image], return_tensors="pt")
    inputs = _move_to_device(inputs, model.device)
    with torch.no_grad():
        output = model.generate(**inputs, max_new_tokens=MAX_NEW_TOKENS_VLM)
    new_tokens = output[:, inputs["input_ids"].shape[1]:]
    return processor.batch_decode(new_tokens, skip_special_tokens=True)[0].strip()


def run_agent(prompt: str) -> str:
    """Text-only → text  (Phase 2 collaboration, agent-side)"""
    messages = [{
        "role": "user",
        "content": [{"type": "text", "text": prompt}],
    }]
    text = processor.apply_chat_template(
        messages, tokenize=False, add_generation_prompt=True
    )
    inputs = processor(text=[text], return_tensors="pt")
    inputs = _move_to_device(inputs, model.device)
    with torch.no_grad():
        output = model.generate(**inputs, max_new_tokens=MAX_NEW_TOKENS_AGENT)
    new_tokens = output[:, inputs["input_ids"].shape[1]:]
    return processor.batch_decode(new_tokens, skip_special_tokens=True)[0].strip()


def run_central_llm(prompt: str) -> str:
    """
    Central LLM for Joint Planning (Phase 3).
    Uses central_processor / central_model if defined in globals,
    otherwise falls back to the agent model/processor.
    → To plug in a separate backbone, define central_processor and central_model before running.
    """
    _processor = globals().get("central_processor", processor)
    _model     = globals().get("central_model",     model)

    messages = [{
        "role": "user",
        "content": [{"type": "text", "text": prompt}],
    }]
    text = _processor.apply_chat_template(
        messages, tokenize=False, add_generation_prompt=True
    )
    inputs = _processor(text=[text], return_tensors="pt")
    inputs = _move_to_device(inputs, _model.device)
    with torch.no_grad():
        output = _model.generate(**inputs, max_new_tokens=MAX_NEW_TOKENS_CENTRAL)
    new_tokens = output[:, inputs["input_ids"].shape[1]:]
    return _processor.batch_decode(new_tokens, skip_special_tokens=True)[0].strip()



# 3. Prompt Builders  (task-agnostic, role/structure only)


def build_phase1_prompt(my_role: str, other_role: str, task: str) -> str:
    return f"""
You are an agent responsible for the {my_role}.
You can observe only your own space and cannot access the {other_role}.

Task: {task}

Analyze your space carefully and produce a structured response using the tags below.

<ROOM_STATE>
Describe the current state of the {my_role} based on your observation.
</ROOM_STATE>

<OWN_PLAN>
List concrete actions you will take in the {my_role} to complete the task.
Number each action.
</OWN_PLAN>
""".strip()


def build_phase2_prompt(
    my_role: str,
    other_role: str,
    task: str,
    my_plan: str,
    other_state: str,
    round_num: int,
) -> str:
    return f"""
You are an agent responsible for the {my_role}.  [Collaboration round {round_num}]

Task: {task}

--- Your current plan ---
{my_plan}

--- {other_role.title()} agent's space state ---
{other_state}

Update your plan by considering the state of the {other_role}.
Adjust your actions to complement what the {other_role} agent is likely doing.

<UPDATED_PLAN>
Your revised action list for the {my_role}, numbered, incorporating the collaboration.
</UPDATED_PLAN>

<HANDOFF>
A brief message to the {other_role} agent: what you will handle on your side.
</HANDOFF>
""".strip()


def build_joint_planning_prompt(
    task: str,
    role_a: str,
    role_b: str,
    plan_a: str,
    handoff_a: str,
    plan_b: str,
    handoff_b: str,
) -> str:
    return f"""
You are a central coordination agent.
Two room agents have each produced a plan. Synthesize them into one coherent plan.

Task: {task}

=== {role_a.title()} Agent — Final Plan ===
{plan_a}

Handoff message from {role_a}:
{handoff_a}

=== {role_b.title()} Agent — Final Plan ===
{plan_b}

Handoff message from {role_b}:
{handoff_b}

Produce a single unified action plan.
Do NOT separate actions by room.
Merge all actions into one numbered list ordered by priority or sequence.
Each action should be self-contained and clearly describe what needs to be done.

<JOINT_PLAN>
1. ...
2. ...
3. ...
</JOINT_PLAN>
""".strip()


# 4. PHASE 1 — Independent Observation (VLM)

print_phase("PHASE 1: Independent Observation")

agent_a_out = run_vlm(image_a_path, build_phase1_prompt(AGENT_A_ROLE, AGENT_B_ROLE, TASK))
agent_b_out = run_vlm(image_b_path, build_phase1_prompt(AGENT_B_ROLE, AGENT_A_ROLE, TASK))

print(f"\n--- Agent A ({AGENT_A_ROLE}) ---\n", agent_a_out)
print(f"\n--- Agent B ({AGENT_B_ROLE}) ---\n", agent_b_out)

a_state   = extract_section(agent_a_out, "ROOM_STATE")
a_plan    = extract_section(agent_a_out, "OWN_PLAN")
a_handoff = ""

b_state   = extract_section(agent_b_out, "ROOM_STATE")
b_plan    = extract_section(agent_b_out, "OWN_PLAN")
b_handoff = ""


# 5. PHASE 2 — N-Round Cross-Agent Collaboration (Agent LLM)

print_phase(f"PHASE 2: Collaboration ({COLLABORATION_ROUNDS} rounds)")

for round_idx in range(1, COLLABORATION_ROUNDS + 1):
    print(f"\n--- Round {round_idx} ---")

    # Agent A reads B's state → updates its plan
    a_out = run_agent(build_phase2_prompt(
        my_role=AGENT_A_ROLE, other_role=AGENT_B_ROLE, task=TASK,
        my_plan=a_plan, other_state=b_state, round_num=round_idx,
    ))
    a_plan    = extract_section(a_out, "UPDATED_PLAN") or a_plan
    a_handoff = extract_section(a_out, "HANDOFF")

    # Agent B reads A's state → updates its plan
    b_out = run_agent(build_phase2_prompt(
        my_role=AGENT_B_ROLE, other_role=AGENT_A_ROLE, task=TASK,
        my_plan=b_plan, other_state=a_state, round_num=round_idx,
    ))
    b_plan    = extract_section(b_out, "UPDATED_PLAN") or b_plan
    b_handoff = extract_section(b_out, "HANDOFF")

    print(f"  Agent A ({AGENT_A_ROLE}) — round {round_idx}:\n{a_plan}")
    print(f"  Agent B ({AGENT_B_ROLE}) — round {round_idx}:\n{b_plan}")


# 6. PHASE 3 — Central LLM Joint Planning

print_phase("PHASE 3: Central LLM Joint Planning")

joint_plan_raw = run_central_llm(build_joint_planning_prompt(
    task=TASK,
    role_a=AGENT_A_ROLE, role_b=AGENT_B_ROLE,
    plan_a=a_plan, handoff_a=a_handoff,
    plan_b=b_plan, handoff_b=b_handoff,
))

print("\n" + "=" * 60)
print("JOINT PLAN (Central LLM)")
print("=" * 60)
print(extract_section(joint_plan_raw, "JOINT_PLAN") or joint_plan_raw)
