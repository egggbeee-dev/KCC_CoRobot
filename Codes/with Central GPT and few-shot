
TASK = "Prepare the house for a small family party in 30 minutes.  Each agent stays in their room."

AGENT_PHASE1_FEW_SHOT = """
Example:
<ROOM_TYPE>kitchen</ROOM_TYPE>
<OFFER>
- What I can handle: Comprehensive snack & drink prep.
- What I can provide: A tray of sandwiches, chilled sodas, and clean glassware.
- Where it will be available: At the boundary (Kitchen Island).
- When it will be ready: In 15 minutes.
- What I need: Agent B to transfer items to the living room and manage trash disposal later.
</OFFER>
""".strip()

CENTRAL_FEW_SHOT = """
Example Joint Plan:
1. [kitchen] Prepare chilled drinks and appetizers.
2. [living room] Vacuum the floor and set mood lighting.
3. [kitchen] Place the appetizer tray on the kitchen island boundary.
4. [living room] Pick up the tray from the kitchen island and move it to the coffee table.
5. [living room] Start the party playlist and arrange guest seating.
6. [kitchen] Clean the preparation area and organize waste bins.
""".strip()

# 1. Core Utilities
def run_vlm(image_path, prompt):
    image = ImageOps.exif_transpose(Image.open(image_path)).convert("RGB")
    messages = [{"role": "user", "content": [{"type": "image"}, {"type": "text", "text": prompt}]}]
    text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
    inputs = processor(text=[text], images=[image], return_tensors="pt").to(model.device)
    with torch.no_grad():
        output = model.generate(**inputs, max_new_tokens=1024)
    return processor.batch_decode(output[:, inputs["input_ids"].shape[1]:], skip_special_tokens=True)[0].strip()

def run_central_llm(prompt):
    response = client.chat.completions.create(
        model=CENTRAL_MODEL,
        messages=[
            {"role": "system", "content": "You are a professional party coordinator. Create a strictly sequential, high-density 1-2-3 timeline. Ensure logical handoffs and no idle time."},
            {"role": "user", "content": prompt}
        ],
        temperature=0.1
    )
    return response.choices[0].message.content.strip()

def extract_section(text, tag):
    match = re.search(rf"<{tag}>(.*?)</{tag}>", text, re.DOTALL | re.IGNORECASE)
    return match.group(1).strip() if match else ""


# 2. Prompt Builders
def build_phase1_prompt():
    return f"Identify your room and resources. {AGENT_PHASE1_FEW_SHOT}\nTask: {TASK}\nReturn: <ROOM_TYPE>, <OBSERVATION>, <CAN_DO>, <CANNOT_DO>, <OFFER>."

def build_phase2_prompt(my_role, my_obs, other_offer):
    return f"""
Agent: {my_role}. Stay in your room. 
Your Observation: {my_obs}
Other Agent's Offer: {other_offer}

<UPDATED_PLAN>
Write 5+ detailed, sequential steps for YOUR ROOM ONLY.
Focus: Deep preparation, explicit handoff points, and guest-ready finishing touches.
</UPDATED_PLAN>
""".strip()

def build_central_prompt(a, b):
    return f"""
{CENTRAL_FEW_SHOT}

Combine the plans below into one chronological timeline (1, 2, 3...). 
Ensure logical flow: an item must be 'placed' by one agent before it is 'picked up' by another.

Agent A ({a['role']}): 
Plan: {a['plan']}
Offer: {a['offer']}

Agent B ({b['role']}): 
Plan: {b['plan']}
Offer: {b['offer']}

<JOINT_PLAN>
Create a strictly numbered, step-by-step master plan. Use [room name] for each step.
</JOINT_PLAN>
""".strip()

# 3. Execution Flow
def execute_multi_agent_collab():
    # Phase 1
    print("\n--- PHASE 1: INDEPENDENT OBSERVATIONS ---")
    raw_a = run_vlm(image_a_path, build_phase1_prompt())
    raw_b = run_vlm(image_b_path, build_phase1_prompt())
    
    print(f"\n[AGENT A RAW]\n{raw_a}")
    print(f"\n[AGENT B RAW]\n{raw_b}")

    data_a = {"role": extract_section(raw_a, "ROOM_TYPE"), "obs": extract_section(raw_a, "OBSERVATION"), "offer": extract_section(raw_a, "OFFER")}
    data_b = {"role": extract_section(raw_b, "ROOM_TYPE"), "obs": extract_section(raw_b, "OBSERVATION"), "offer": extract_section(raw_b, "OFFER")}

    # Phase 2
    print("\n--- PHASE 2: COORDINATED INDIVIDUAL PLANS ---")
    raw_plan_a = run_vlm(image_a_path, build_phase2_prompt(data_a['role'], data_a['obs'], data_b['offer']))
    raw_plan_b = run_vlm(image_b_path, build_phase2_prompt(data_b['role'], data_b['obs'], data_a['offer']))
    
    print(f"\n[AGENT A UPDATED PLAN]\n{raw_plan_a}")
    print(f"\n[AGENT B UPDATED PLAN]\n{raw_plan_b}")

    data_a["plan"] = extract_section(raw_plan_a, "UPDATED_PLAN")
    data_b["plan"] = extract_section(raw_plan_b, "UPDATED_PLAN")

    # Phase 3
    print("\n--- PHASE 3: MASTER JOINT PLANNING ---")
    central_prompt = build_central_prompt(data_a, data_b)
    print(f"\n[CENTRAL INPUT DATA]\n{central_prompt}")
    
    final_out = run_central_llm(central_prompt)
    joint_plan = extract_section(final_out, "JOINT_PLAN") or final_out
    
    print("\n--- FINAL MASTER JOINT PLAN ---")
    print(joint_plan)
    print("\n--------------------------------")

execute_multi_agent_collab()
